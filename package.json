  },
  "dependencies": {
    "@bragi-gmbh/space-sdk": "workspace:*",
    "@bragi/sdk": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@bragi/space-verifier": "workspace:*",
    "@playwright/test": "^1.61.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5",
    "vite": "^7.3.3",
    "vitest": "^3.2.6"
  }
}
