{
  "name": "@bragi/space-lumen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "bragi space check",
    "check:json": "bragi space check --json",
    "test": "vitest --exclude \"tests/**\"",
    "test:run": "vitest run --passWithNoTests --exclude \"tests/**\"",
