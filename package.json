{
  "name": "space-lumen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "bragi space check",
    "check:json": "bragi space check --json",
    "test": "vitest --passWithNoTests --exclude \"tests/**\"",
    "test:run": "vitest run --passWithNoTests --exclude \"tests/**\"",
    "test:publish-gate": "playwright test --config playwright.config.ts",
    "integration-check": "node .bragi/managed/space-ci/checks/integration-check.mjs ."
  },
  "dependencies": {
    "@bragi-gmbh/space-sdk": "0.5.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5",
    "vite": "^8.0.16",
    "vitest": "^4.1"
  }
}
